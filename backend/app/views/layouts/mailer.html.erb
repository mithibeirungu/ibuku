<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace;
        background-color: #fbf1c7;
        color: #3c3836;
        padding: 20px;
      }
      .card {
        background-color: #f2e5bc;
        border: 2px solid #d5c4a1;
        padding: 30px;
        max-width: 500px;
        margin: 0 auto;
        border-radius: 6px;
      }
      .code {
        font-size: 32px;
        letter-spacing: 6px;
        font-weight: bold;
        color: #79740e;
        padding: 12px;
        background: #ebdbb2;
        border: 1px dashed #bdae93;
        text-align: center;
        margin: 20px 0;
      }
      .footer {
        font-size: 12px;
        color: #7c6f64;
        margin-top: 20px;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <%= yield %>
    </div>
  </body>
</html>

